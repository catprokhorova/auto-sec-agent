# ==============================================================================
# Autonomous CI/CD Security Agent - Environment Configuration
# ==============================================================================

# LLM Cognitive Engine (AWS Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
BEDROCK_MODEL_SONNET=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MODEL_HAIKU=anthropic.claude-3-5-haiku-20241022-v1:0
USE_MOCK_LLM=true

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword123

# Vector Store / RAG (OpenSearch)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Secret_Password_123!
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# Observability & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-mock-key
LANGFUSE_SECRET_KEY=sk-lf-mock-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# Execution Sandbox (Docker)
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_DEFAULT_IMAGE=python:3.11-slim
SANDBOX_EXEC_TIMEOUT_SEC=60

# Version Control & CI/CD Integration
GIT_BASE_BRANCH=main
GITHUB_TOKEN=ghp_mocktoken
GITLAB_TOKEN=glpat_mocktoken
WEBHOOK_SECRET=supersecretwebhooktoken

# Agent Circuit Breaker & Safety Defenses
MAX_LOOP_COUNT=3
TOKEN_PRUNING_MAX_LINES=200
